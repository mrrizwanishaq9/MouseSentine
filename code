    # ========================================================
    # Face detection
    # ========================================================

    def face_check(self):

        camera = None

        try:

            camera = cv2.VideoCapture(
                0
            )

            if not camera.isOpened():

                messagebox.showerror(
                    APP_NAME,
                    "Camera could not be opened."
                )

                return

            cascade = cv2.CascadeClassifier(
                cv2.data.haarcascades +
                "haarcascade_frontalface_default.xml"
            )

            found = False
            start = time.time()

            while time.time() - start < 8:

                ret, frame = (
                    camera.read()
                )

                if not ret:
                    continue

                gray = cv2.cvtColor(
                    frame,
                    cv2.COLOR_BGR2GRAY
                )

                faces = (
                    cascade.detectMultiScale(
                        gray,
                        1.1,
                        5,
                        minSize=(80, 80)
                    )
                )

                if len(faces) > 0:
                    found = True

                for x, y, w, h in faces:

                    cv2.rectangle(
                        frame,
                        (x, y),
                        (x + w, y + h),
                        (0, 255, 0),
                        2
                    )

                    cv2.putText(
                        frame,
                        "FACE DETECTED",
                        (x, y - 10),
                        cv2.FONT_HERSHEY_SIMPLEX,
                        0.7,
                        (0, 255, 0),
                        2
                    )

                cv2.imshow(
                    "MouseSentinel Face Check",
                    frame
                )

                if (
                    cv2.waitKey(1)
                    & 0xFF
                ) == 27:

                    break

            if found:

                self.add_log(
                    "Face detected.",
                    "FACE"
                )

                messagebox.showinfo(
                    APP_NAME,
                    "Face detected successfully."
                )

            else:

                self.add_log(
                    "No face detected.",
                    "FACE"
                )

                messagebox.showwarning(
                    APP_NAME,
                    "No face was detected."
                )

        except Exception as error:

            messagebox.showerror(
                APP_NAME,
                f"Face detection error:\n{error}"
            )

        finally:

            if camera:
                camera.release()

            cv2.destroyAllWindows()

