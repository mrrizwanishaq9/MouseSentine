    # Manual lock
    # ========================================================

    def lock_now(self):

        answer = messagebox.askyesno(
            APP_NAME,
            "Windows will be locked now.\n\n"
            "Continue?"
        )

        if not answer:
            return

        self.add_log(
            "Manual Windows lock requested.",
            "LOCK"
        )

        if windows_lock():

            self.add_log(
                "Windows lock command sent.",
                "LOCK"
            )

        else:

            messagebox.showerror(
                APP_NAME,
                "Windows lock could not be requested."
            )

    # ========================================================
    # Camera
    # ========================================================

    def capture_photo(
        self,
        prefix="capture"
    ):

        if not CONFIG.get(
            "camera_capture",
            True
        ):
            return None

        filename = (
            prefix +
            "_" +
            datetime.now().strftime(
                "%Y%m%d_%H%M%S"
            ) +
            ".jpg"
        )

        path = (
            CAPTURE_DIR /
            filename
        )

        camera = None

        try:

            camera = cv2.VideoCapture(
                0
            )

            if not camera.isOpened():

                self.add_log(
                    "Camera could not be opened.",
                    "CAMERA"
                )

                return None

            time.sleep(
                0.5
            )

            ret, frame = (
                camera.read()
            )

            if ret:

                cv2.imwrite(
                    str(path),
                    frame
                )

                self.add_log(
                    f"Photo saved: {filename}",
                    "CAMERA"
                )

                return path

        except Exception as error:

            self.add_log(
                f"Camera error: {error}",
                "ERROR"
            )

        finally:

            if camera:

                camera.release()

        return None

    def test_camera(self):

        self.add_log(
            "Starting camera test.",
            "CAMERA"
        )

        path = self.capture_photo(
            "camera_test"
        )

        if not path:

            messagebox.showerror(
                APP_NAME,
                "Camera test failed.\n\n"
                "Check Windows Camera permissions."
            )

            return

        try:

            image = cv2.imread(
                str(path)
            )

            if image is not None:

                cv2.imshow(
                    "MouseSentinel Camera Test",
                    image
                )

                cv2.waitKey(
                    2500
                )

                cv2.destroyAllWindows()

        except Exception:
            pass

        messagebox.showinfo(
            APP_NAME,
