def get_fernet():
    if Fernet is None:
        return None

    try:
        if not KEY_FILE.exists():
            key = Fernet.generate_key()

            with open(
                KEY_FILE,
                "wb"
            ) as file:
                file.write(key)

        with open(
            KEY_FILE,
            "rb"
        ) as file:
            key = file.read()

        return Fernet(key)

    except Exception:
        return None


FERNET = get_fernet()


def encrypted_log(event, details=""):
    timestamp = datetime.now().strftime(
        "%Y-%m-%d %H:%M:%S"
    )

    record = {
        "timestamp": timestamp,
        "event": event,
        "details": details
    }

    raw = json.dumps(
        record,
        ensure_ascii=False
    ).encode("utf-8")

    try:
        if FERNET:
            encrypted = FERNET.encrypt(raw)

            with open(
                ENCRYPTED_LOG_FILE,
                "ab"
            ) as file:
                file.write(
                    encrypted + b"\n"
                )

        else:
            # Fallback only if cryptography is unavailable.
            # This is clearly marked as non-encrypted.
            with open(
                LOG_DIR / "security_events_fallback.log",
                "a",
                encoding="utf-8"
            ) as file:
                file.write(
                    json.dumps(
                        record,
                        ensure_ascii=False
                    ) + "\n"
                )

    except Exception:
        pass


def read_encrypted_logs():
    records = []

    if not ENCRYPTED_LOG_FILE.exists():
        return records

    if not FERNET:
        return records

    try:
        with open(
            ENCRYPTED_LOG_FILE,
            "rb"
        ) as file:

            for line in file:

                line = line.strip()

                if not line:
                    continue

                try:
                    decrypted = FERNET.decrypt(
                        line
                    )

                    record = json.loads(
                        decrypted.decode("utf-8")
                    )

                    records.append(record)

                except Exception:
                    continue

    except Exception:
        pass

    return records


