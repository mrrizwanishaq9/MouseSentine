    # PIN
    # ========================================================

    def change_pin(self):

        old_exists = bool(
            CONFIG.get(
                "pin_hash",
                ""
            )
        )

        if old_exists:

            old = simpledialog.askstring(
                APP_NAME,
                "Current PIN:",
                show="*"
            )

            if old is None:
                return

            if not verify_pin(old):

                messagebox.showerror(
                    APP_NAME,
                    "Incorrect current PIN."
                )

                return

        new_pin = simpledialog.askstring(
            APP_NAME,
            "New PIN:",
            show="*"
        )

        if not new_pin:
            return

        if len(new_pin) < 4:

            messagebox.showerror(
                APP_NAME,
                "PIN must contain at least 4 characters."
            )

            return

        pin_hash, salt = (
            create_pin_hash(
                new_pin
            )
        )

        CONFIG["pin_hash"] = pin_hash
        CONFIG["pin_salt"] = salt

        save_config(
            CONFIG
        )

        self.add_log(
            "Security PIN changed.",
            "SECURITY"
        )

        messagebox.showinfo(
            APP_NAME,
            "PIN saved successfully."
        )

    # ========================================================
    # Startup
    # ========================================================

    def enable_startup(self):

        try:

            startup = (
                Path(
                    os.environ["APPDATA"]
                )
                /
                "Microsoft"
                /
                "Windows"
                /
                "Start Menu"
                /
                "Programs"
                /
                "Startup"
            )

            startup.mkdir(
                parents=True,
                exist_ok=True
            )

            bat = (
                startup /
                "MouseSentinel_V23.bat"
            )

            python_exe = (
                os.sys.executable
            )

            script = (
                Path(
                    __file__
                ).resolve()
            )

            content = (
                "@echo off\n"
                f'cd /d "{script.parent}"\n'
                f'"{python_exe}" "{script}"\n'
            )

            with open(
                bat,
                "w",
                encoding="utf-8"
            ) as file:

                file.write(
                    content
                )

            self.add_log(
                "Windows startup enabled.",
                "STARTUP"
            )

        except Exception as error:

            self.add_log(
                f"Startup error: {error}",
                "ERROR"
            )

    def disable_startup(self):

        try:

            startup = (
                Path(
                    os.environ["APPDATA"]
                )
                /
                "Microsoft"
                /
                "Windows"
                /
                "Start Menu"
                /
                "Programs"
                /
                "Startup"
            )

            bat = (
                startup /
                "MouseSentinel_V23.bat"
            )

            if bat.exists():
                bat.unlink()

            self.add_log(
                "Windows startup disabled.",
                "STARTUP"
            )

        except Exception:
            pass

    # ========================================================
    # Dashboard update
    # ========================================================

    def update_dashboard(self):

        try:

            cpu = psutil.cpu_percent()

            ram = psutil.virtual_memory()

            self.cpu_var.set(
                f"CPU: {cpu:.0f}%"
            )

            self.ram_var.set(
                f"RAM: {ram.percent:.0f}%"
            )

            battery = (
                psutil.sensors_battery()
            )

            if battery:

                self.battery_var.set(
                    f"Battery: "
                    f"{battery.percent:.0f}%"
                )

            else:

                self.battery_var.set(
                    "Battery: N/A"
                )

            self.mouse_var.set(
                str(
                    self.mouse_events
                )
            )

            self.keyboard_var.set(
                str(
                    self.keyboard_events
                )
            )

            elapsed = int(
                time.time()
                -
                self.last_activity
            )

            self.inactive_var.set(
                f"{elapsed // 60:02d}:"
                f"{elapsed % 60:02d}"
            )

            self.score_var.set(
                f"{self.security_score()}%"
            )

        except Exception:
            pass

        if not self.closing:

            self.root.after(
                2000,
                self.update_dashboard
            )

    # ========================================================
    # Security Score
    # ========================================================

    def security_score(self):

        score = 100

        if not CONFIG.get(
            "auto_lock",
            False
        ):
            score -= 15

        if not CONFIG.get(
            "usb_lock",
            False
        ):
            score -= 10

        if not CONFIG.get(
            "camera_capture",
            True
        ):
            score -= 5

        if not CONFIG.get(
            "alarm",
            True
        ):
            score -= 5

        if not CONFIG.get(
            "notifications",
            True
        ):
            score -= 5

        if not CONFIG.get(
            "pin_hash",
            ""
        ):
            score -= 10

        return max(
            0,
            min(
                100,
                score
            )
        )

    # ========================================================
    # Export reports
    # ========================================================

    def export_report(self):

        records = read_encrypted_logs()

        if not records:

            messagebox.showinfo(
                APP_NAME,
                "No encrypted event records available yet."
            )

            return

        default_name = (
            "MouseSentinel_V23_Report_"
            +
            datetime.now().strftime(
                "%Y%m%d_%H%M%S"
            )
            +
            ".txt"
        )

        destination = (
            filedialog.asksaveasfilename(
                title="Save Security Report",
                initialfile=default_name,
                defaultextension=".txt",
                filetypes=[
                    (
                        "Text File",
                        "*.txt"
                    ),
                    (
                        "CSV File",
                        "*.csv"
                    )
                ]
            )
        )

        if not destination:
            return

        try:

            if destination.lower().endswith(
                ".csv"
            ):

                with open(
                    destination,
                    "w",
                    newline="",
                    encoding="utf-8"
                ) as file:

                    writer = csv.DictWriter(
                        file,
                        fieldnames=[
                            "timestamp",
                            "event",
                            "details"
                        ]
                    )

                    writer.writeheader()

                    writer.writerows(
                        records
                    )

            else:

                with open(
                    destination,
                    "w",
                    encoding="utf-8"
                ) as file:

                    file.write(
                        "====================================\n"
                    )

                    file.write(
                        "       MouseSentinel V23 REPORT\n"
                    )

                    file.write(
                        "====================================\n\n"
                    )

                    file.write(
                        f"Generated: {now()}\n"
                    )

                    file.write(
                        f"Security Score: "
                        f"{self.security_score()}%\n"
                    )

                    file.write(
                        f"Mouse Events: "
                        f"{self.mouse_events}\n"
                    )

                    file.write(
                        f"Keyboard Events: "
                        f"{self.keyboard_events}\n"
                    )

                    file.write(
                        f"Security Events: "
                        f"{self.security_events}\n\n"
                    )

                    file.write(
                        "EVENT HISTORY\n"
                    )

                    file.write(
                        "------------------------------------\n"
                    )

                    for record in records:

                        file.write(
                            f"{record.get('timestamp', '')} | "
                            f"{record.get('event', '')} | "
                            f"{record.get('details', '')}\n"
                        )

            self.add_log(
                f"Report exported: {destination}",
                "REPORT"
            )

            messagebox.showinfo(
                APP_NAME,
                "Report exported successfully."
            )

        except Exception as error:

            messagebox.showerror(
                APP_NAME,
                f"Report error:\n{error}"
            )

    # ========================================================
    # Shutdown
    # ========================================================

    def close_app(self):

        if self.running:

            answer = messagebox.askyesno(
                APP_NAME,
                "Protection is currently running.\n\n"
                "Stop protection and exit?"
            )

            if not answer:
                return

        self.closing = True
        self.running = False

        try:

            if self.mouse_listener:
                self.mouse_listener.stop()

        except Exception:
            pass

        try:

            if self.keyboard_listener:
                self.keyboard_listener.stop()

        except Exception:
            pass

        self.root.destroy()


