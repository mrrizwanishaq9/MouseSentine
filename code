    def add_log(
        self,
        message,
        event="INFO"
    ):

        timestamp = datetime.now().strftime(
            "%H:%M:%S"
        )

        line = (
            f"[{timestamp}] "
            f"{event}: {message}"
        )

        def update():

            try:

                self.log_box.insert(
                    "end",
                    line + "\n"
                )

                self.log_box.see(
                    "end"
                )

            except Exception:
                pass

        self.root.after(
            0,
            update
        )

        encrypted_log(
            event,
            message
        )

    # ========================================================
    # Activity callbacks
    # ========================================================

    def mouse_move(
        self,
        x,
        y
    ):

        if not self.running:
            return

        self.mouse_events += 1
        self.last_activity = time.time()

        if self.mouse_events % 50 == 0:

            self.add_log(
                f"Mouse activity count: "
                f"{self.mouse_events}",
                "ACTIVITY"
            )

    def mouse_click(
        self,
        x,
        y,
        button,
        pressed
    ):

        if not self.running:
            return

        if pressed:

            self.mouse_events += 1
            self.last_activity = time.time()

    def keyboard_press(
        self,
        key
    ):

        if not self.running:
            return

        self.keyboard_events += 1
        self.last_activity = time.time()

        # The actual key is intentionally NOT recorded.
        if self.keyboard_events % 50 == 0:

            self.add_log(
                f"Keyboard activity count: "
                f"{self.keyboard_events}",
                "ACTIVITY"
            )

    # ========================================================
    # Protection
    # ========================================================

    def start(self):

        if self.running:

            messagebox.showinfo(
                APP_NAME,
                "Protection is already running."
            )

            return

        self.running = True
        self.locking = False

        self.last_activity = time.time()

        self.mouse_listener = mouse.Listener(
            on_move=self.mouse_move,
            on_click=self.mouse_click
        )

        self.keyboard_listener = keyboard.Listener(
            on_press=self.keyboard_press
        )

        self.mouse_listener.start()
        self.keyboard_listener.start()

        self.status_var.set(
            "PROTECTED"
        )

        self.mode_var.set(
            "SAFE TEST MODE"
            if CONFIG.get(
                "test_mode",
                True
            )
            else "ACTIVE SECURITY"
        )

        self.add_log(
            "Protection started.",
            "SYSTEM"
        )

        notify_user(
            APP_NAME,
            "Protection started."
        )

        threading.Thread(
            target=self.inactivity_monitor,
            daemon=True
        ).start()

        threading.Thread(
            target=self.usb_monitor,
            daemon=True
        ).start()

    def stop(self):

        self.running = False

        try:
            if self.mouse_listener:
                self.mouse_listener.stop()
        except Exception:
            pass

        try:
            if self.keyboard_listener:
                self.keyboard_listener.stop()
        except Exception:
            pass

        self.status_var.set(
            "OFFLINE"
        )

        self.add_log(
            "Protection stopped.",
            "SYSTEM"
        )

    # ========================================================
    # Inactivity
    # ========================================================

    def inactivity_monitor(self):

        while self.running:

            elapsed = int(
                time.time() -
                self.last_activity
            )

            timeout = int(
                CONFIG.get(
                    "timeout",
                    300
                )
            )

            if (
                CONFIG.get(
                    "auto_lock",
                    False
                )
                and elapsed >= timeout
                and not self.locking
            ):

                self.security_response(
                    "INACTIVITY",
                    f"No activity for {timeout} seconds."
                )

            time.sleep(1)

    # ========================================================
    # USB detection
    # ========================================================

    def get_usb_devices(self):

        devices = set()

        try:

            command = [
                "powershell",
                "-NoProfile",
                "-Command",
                (
                    "Get-CimInstance "
                    "Win32_DiskDrive | "
                    "Where-Object "
                    "{$_.InterfaceType -eq 'USB'} | "
                    "Select-Object -ExpandProperty DeviceID"
                )
            ]

            result = subprocess.run(
                command,
                capture_output=True,
                text=True,
                timeout=5
            )

            for line in result.stdout.splitlines():

                value = line.strip()

                if value:
                    devices.add(value)

        except Exception:
            pass

        return devices

    def usb_monitor(self):

        self.usb_state = (
            self.get_usb_devices()
        )

        while self.running:

            current = (
                self.get_usb_devices()
            )

            new_devices = (
                current -
                self.usb_state
            )

            if new_devices:

                self.security_events += 1

                self.add_log(
                    "New USB device detected.",
                    "USB"
                )

                notify_user(
                    APP_NAME,
                    "New USB storage device detected."
                )

                if CONFIG.get(
                    "usb_lock",
                    False
                ):

                    self.security_response(
                        "USB",
                        "New USB device detected."
                    )

            self.usb_state = current

            time.sleep(4)

    # ========================================================
    # Security response
    # ========================================================

    def security_response(
        self,
        reason,
        details
    ):

        if self.locking:
            return

        self.locking = True

        self.security_events += 1

        self.add_log(
            details,
            "SECURITY"
        )

        notify_user(
            "MouseSentinel Security Alert",
            f"{reason}: {details}"
        )

        # Camera capture is optional.
        self.capture_photo(
            f"security_{reason.lower()}"
        )

        alarm()

        # Safe Test Mode never locks Windows.
        if CONFIG.get(
            "test_mode",
            True
        ):

            self.add_log(
                "TEST MODE: Windows lock skipped.",
                "SAFE"
            )

        else:

            if (
                CONFIG.get(
                    "auto_lock",
                    False
                )
                or
                (
                    reason == "USB"
                    and
                    CONFIG.get(
                        "usb_lock",
                        False
                    )
                )
            ):

                time.sleep(1)

                if windows_lock():

                    self.add_log(
                        "Windows lock requested.",
                        "LOCK"
                    )

                else:

                    self.add_log(
                        "Windows lock request failed.",
                        "ERROR"
                    )

        self.last_activity = time.time()
        self.locking = False

