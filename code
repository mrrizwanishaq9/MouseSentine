def now():
    return datetime.now().strftime(
        "%Y-%m-%d %H:%M:%S"
    )


def notify_user(title, message):
    if not CONFIG.get(
        "notifications",
        True
    ):
        return

    try:
        if notification:
            notification.notify(
                title=title,
                message=message,
                app_name=APP_NAME,
                timeout=5
            )
    except Exception:
        pass


def alarm():
    if not CONFIG.get(
        "alarm",
        True
    ):
        return

    try:
        if winsound:

            for _ in range(3):
                winsound.Beep(
                    1200,
                    300
                )
                time.sleep(0.1)

    except Exception:
        pass


def windows_lock():
    try:
        return bool(
            ctypes.windll.user32.LockWorkStation()
        )
    except Exception:
        return False


